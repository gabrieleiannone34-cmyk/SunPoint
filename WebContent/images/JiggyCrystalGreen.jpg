<script>
  window.INITIAL_SIZE_SYSTEM = 'EU';
</script>

<script>
(function() {
  const PREF_KEY = 'preferredSizeSystem';
  const SYSTEMS = ['EU', 'UK', 'US'];

  function setSystem(sys) {
  sys = (sys || 'EU').toUpperCase();
  if (!SYSTEMS.includes(sys)) sys = 'EU';
    document.documentElement.setAttribute('data-size-system', sys);
    localStorage.setItem(PREF_KEY, sys);
  }

  function normalizeTabs() {
    document.querySelectorAll('.cstm_sizes li').forEach(li => {
      const val = (li.getAttribute('data-system') || li.textContent || '').trim().toUpperCase();
      if (SYSTEMS.includes(val)) li.setAttribute('data-system', val);
    });
  }

  function init() {
    normalizeTabs();
    const saved = (localStorage.getItem(PREF_KEY) || '').toUpperCase();
    const initial = (window.INITIAL_SIZE_SYSTEM || 'EU').toUpperCase();
    const start = SYSTEMS.includes(saved) ? saved : (SYSTEMS.includes(initial) ? initial : 'EU');
    setSystem(start);
  }

  document.addEventListener('click', event => {
    const li = event.target.closest('.cstm_sizes li');
    if (!li) return;
    const sys = (li.getAttribute('data-system') || li.textContent || '').trim().toUpperCase();
    if (SYSTEMS.includes(sys)) setSystem(sys);
  }, { passive: true });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();

  document.addEventListener('shopify:section:load', init);

  const target = document.querySelector('.product_variant_option_flex') || document.querySelector('variant-selects') || document.body;

  new MutationObserver(mutations => {
    for (const mutation of mutations) {
      if (mutation.type === 'childList' && mutation.addedNodes && mutation.addedNodes.length) {
        normalizeTabs();
        break;
      }
    }
  }).observe(target, { childList: true, subtree: true });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function isMobileView() {
    return window.matchMedia('only screen and (min-width: 200px) and (max-width: 767px)').matches;
  }

  function applyStyles() {
    const isMobile = isMobileView();
    const paddingValue = isMobile ? '15px' : '45px';
    const marginBottom = isMobile ? '-10px' : '-5px';
    const variantSelects = document.querySelectorAll('variant-selects');

    variantSelects.forEach(container => {
      const fieldsets = container.querySelectorAll('fieldset');

      if (fieldsets.length >= 2) {
        const formLabels = container.querySelectorAll('.form__label');

        formLabels.forEach(label => {
          label.style.display = 'block';
          label.style.paddingInline = paddingValue;
          label.style.marginBottom = marginBottom;
        });

        const productBlock = container.closest('.product__block--variant_picker');

        if (productBlock) {
          const blockLabels = productBlock.querySelectorAll('.form__label');

          blockLabels.forEach(label => {
            label.style.display = 'block';
            label.style.paddingInline = paddingValue;
            label.style.marginBottom = marginBottom;
          });
        }
      }
    });
  }

  function setupVariantSelectors() {
    applyStyles();
  }

  setupVariantSelectors();
  window.addEventListener('resize', applyStyles);
  document.addEventListener('shopify:section:load', setupVariantSelectors);

  const observer = new MutationObserver(function(mutations) {
    let shouldApplyStyles = false;

    for (const mutation of mutations) {
      if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
        for (const node of mutation.addedNodes) {
          if (node.nodeType === Node.ELEMENT_NODE) {
            if (node.tagName === 'VARIANT-SELECTS' || node.querySelector('variant-selects')) {
              shouldApplyStyles = true;
              break;
            }
          }
        }
      }

      if (shouldApplyStyles) break;
    }

    if (shouldApplyStyles) setTimeout(setupVariantSelectors, 50);
  });

  if (document.body) observer.observe(document.body, { childList: true, subtree: true });
});
</script>

<script>
(function() {
  var SYSTEMS = ['EU', 'UK', 'US'];
  var saved = (localStorage.getItem('preferredSizeSystem') || '').toUpperCase();
  var initial = (window.INITIAL_SIZE_SYSTEM || 'EU').toUpperCase();
  var start = SYSTEMS.includes(saved) ? saved : (SYSTEMS.includes(initial) ? initial : 'EU');
  document.documentElement.setAttribute('data-size-system', start);
})();
</script>

<style>
  .product_variant_option_inner label .size-wrap .size-val {
    display: none;
  }

  html[data-size-system="EU"] .size-wrap .size-eu {
    display: inline;
  }


  html:not([data-size-system]) .size-wrap .size-uk,
  html[data-size-system="UK"] .size-wrap .size-uk {
    display: inline;
  }


  html[data-size-system="US"] .size-wrap .size-us {
    display: inline;
  }

  .cstm_sizes li {
    opacity: .6;
    cursor: pointer;
  }

  html[data-size-system="EU"] .cstm_sizes li[data-system="EU"],
  html[data-size-system="UK"] .cstm_sizes li[data-system="UK"],
  html[data-size-system="US"] .cstm_sizes li[data-system="US"] {
    opacity: 1;
    font-family: "Marsden Narrow Bold";
  }

  .cstm_sizes li:focus,
  .cstm_sizes li:hover {
    opacity: .9;
  }

  .variant-size-guide-row {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: 8px;
  }

  .variant-size-guide-row .variant-size-guide-button {
    font-size: 14px !important;
    line-height: 1.2 !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    text-transform: uppercase;
    cursor: pointer;
  }

  .variant_picker_top_right .cstm_sizes {
    position: relative;
    z-index: 1;
    margin-top: 0;
  }
</style>

<script>
(function() {
  function getSizeInput(target) {
    const input = target.closest?.('.klaviyo-bis-trigger');
    if (input) return input;

    const label = target.closest?.('label[for]');
    if (label) return document.getElementById(label.getAttribute('for'));

    return null;
  }

  function updateVariant(target) {
    const sizeInput = getSizeInput(target);
    if (!sizeInput || !sizeInput.classList.contains('klaviyo-bis-trigger')) return;

    const variantId = sizeInput.dataset.variantId;
    if (!variantId) return;

    const formId = sizeInput.getAttribute('form');
    const form = formId ? document.getElementById(formId) : document.querySelector('form[data-type="add-to-cart-form"]');
    if (!form) return;

    const variantInput = form.querySelector('input[name="id"].product-variant-id');
    if (!variantInput) return;

    variantInput.value = variantId;
    variantInput.dispatchEvent(new Event('input', { bubbles: true }));
    variantInput.dispatchEvent(new Event('change', { bubbles: true }));

    const url = new URL(window.location.href);
    url.searchParams.set('variant', variantId);
    window.history.replaceState({}, '', url.toString());

    window.klaviyo_bis_variant_id = variantId;

    console.log('[BIS] Variante preparada antes de Klaviyo:', variantId);
  }

  ['pointerdown', 'mousedown', 'touchstart'].forEach(function(eventName) {
    document.addEventListener(eventName, function(event) {
      updateVariant(event.target);
    }, true);
  });
})();
</script>
