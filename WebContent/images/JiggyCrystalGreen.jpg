        <style data-shopify="">
  #Mega-menu-item- {
    --menu-columns: ;
    --promotions-width: %;
    --promotion-columns: ;
  }

  /* Wrapper como contexto de posicionamiento */
  .slider-wrapper{
    position: relative;
  }

  /* Reservamos espacio para las flechas a ambos lados del carrusel */
  .slider-wrapper .mega-slider-container{
    margin: 0 20px;        /* = arrow-size (44) + gap (16) */
    overflow-x: auto;      /* por si no lo tienes ya */
    scroll-behavior: smooth;
  }

  /* Botones de flecha: visibles, centrados verticalmente y sin tapar el carrusel */
  .slider-wrapper .slider-arrow{
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 9999px;
    background: #fff;
    /*box-shadow: 0 2px 8px rgba(0,0,0,.15);*/
    z-index: 5;
    cursor: pointer;
  }

  /* Lados */
  .slider-wrapper .slider-arrow.left  { left: 0; }
  .slider-wrapper .slider-arrow.right { right: 0; }

  /* Estado deshabilitado: sigue visible pero no clicable */
  .slider-wrapper .slider-arrow[aria-disabled="true"]{
    opacity: .4;
    pointer-events: none;
  }

  /* En móvil reducimos el margen para no robar ancho al contenido */
  @media (max-width: 768px){
    .slider-wrapper .mega-slider-container{ margin: 0 8px; }
    .slider-wrapper .slider-arrow.left  { left: 8px; }
    .slider-wrapper .slider-arrow.right { right: 8px; }
  }

  .slider-wrapper .slider-arrow[hidden]{ display:none !important; }
</style>


