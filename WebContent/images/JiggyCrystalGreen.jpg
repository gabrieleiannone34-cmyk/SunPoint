<script>
/* mod menu */
document.addEventListener("DOMContentLoaded", function() {
  const menuLinks = document.querySelectorAll(".link_type");
  const menus = document.querySelectorAll(".other_mobile_menu");
  const submenusLinks = document.querySelectorAll(".sub-menu__item-link");

  menuLinks.forEach(link => {    
    link.addEventListener("click", function(e) {
      e.preventDefault();

      menuLinks.forEach(mlink => mlink.classList.remove("change_link_active"));

      // 1. obtenemos el tipo desde el data-type
      const type = this.dataset.type?.toLowerCase();
      link.classList.add("change_link_active");

      // 2. ocultamos todos los menús
      menus.forEach(menu => menu.classList.remove("other_mobile_menu_active"));      

      // 3. mostramos el correspondiente      
      const target = document.querySelector(".other_mobile_menu.type-" + type);
      if (target) {
        target.classList.add("other_mobile_menu_active");        
      }      

      sessionStorage.setItem("gender", type);      
    });
  });

  submenusLinks.forEach(link => {
    link.addEventListener("click", function(e) {            
      // 4. guardamos la selección
      type = sessionStorage.getItem("gender");
      sessionStorage.setItem('shop_type', type);
      document.cookie = `gender=${type}; path=/; max-age=${60*60*24*30}`;      
    });
  });
});
</script>

