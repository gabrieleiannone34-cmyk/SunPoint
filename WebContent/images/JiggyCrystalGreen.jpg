<!-- Mega Menu Promotional slider -->
<!-- JS: reemplaza tu initSlider por este -->
<script>
(function(){
  function initSlider(wrapper){
    if (!wrapper || wrapper.__inited) return;
    wrapper.__inited = true;

    const cont  = wrapper.querySelector('.mega-slider-container');
    const left  = wrapper.querySelector('.slider-arrow.left');
    const right = wrapper.querySelector('.slider-arrow.right');    
    const items = cont.querySelectorAll(':scope > *'); 
    if (!cont || !left || !right) return;

    // Aseguramos comportamiento del contenedor
    if (!getComputedStyle(cont).overflowX || getComputedStyle(cont).overflowX === 'visible'){
      cont.style.overflowX = 'auto';
    }
    cont.style.scrollBehavior = cont.style.scrollBehavior || 'smooth';

    const page = () => Math.max(cont.clientWidth, 320);

    const update = () => {
      // Evita medir si está dentro de un <details> cerrado
      const det = wrapper.closest('details');
      if (det && !det.open) return;

      const hasMultiple = items.length > 1;
      const epsilon = 8; // tolerancia por gaps/scrollbar
      const canMove = hasMultiple && (cont.scrollWidth - cont.clientWidth) > epsilon;

      left.hidden = right.hidden = !canMove;

      if (!canMove) return;

      const atStart = cont.scrollLeft <= 0;
      const atEnd   = cont.scrollLeft + cont.clientWidth >= cont.scrollWidth - 1;

      left.setAttribute('aria-disabled',  atStart ? 'true' : 'false');
      right.setAttribute('aria-disabled', atEnd   ? 'true' : 'false');
    };

    left.addEventListener('click',  () => cont.scrollBy({ left: -page(), behavior:'smooth' }));
    right.addEventListener('click', () => cont.scrollBy({ left:  page(), behavior:'smooth' }));
    cont.addEventListener('scroll', update);

    const det = wrapper.closest('details');
    if (det) det.addEventListener('toggle', () => requestAnimationFrame(update));
    window.addEventListener('resize', update);

    // Imágenes lazy pueden cambiar el ancho
    cont.querySelectorAll('img').forEach(img=>{
      if (!img.complete) img.addEventListener('load', update, { once:true });
    });

    // Cambios internos de tamaño
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(update);
      ro.observe(cont);
    }

    update();
  }

  // expone la función por si inicializas múltiples sliders
  window.initMegaSlider = initSlider;

  function initAll(){
    document.querySelectorAll('.slide_multiple .slider-wrapper').forEach(initSlider);
  }

  document.addEventListener('DOMContentLoaded', initAll);

  // Re-inicializa si el tema inyecta nodos luego
  new MutationObserver(() => initAll())
    .observe(document.body, { childList: true, subtree: true });
})();
</script>


