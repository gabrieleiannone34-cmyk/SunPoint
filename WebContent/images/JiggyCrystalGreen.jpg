    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const radioButtons = document.querySelectorAll('input[name="contact[type]"]');
        const tagsInput = document.getElementById('ContactTags-newsletter_3qCrWc');
        
        radioButtons.forEach(function(radio) {
          radio.addEventListener('change', function() {
            if (this.checked) {
              // Se añaden las etiquetas "newsletter" y la opción seleccionada
              tagsInput.value = 'newsletter,' + this.value;
            }
          });
        });
      });
