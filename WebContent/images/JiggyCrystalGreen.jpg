</script><script>   
  /* Menu drawer adjustments according to announcement bar height + mobile nav (XS) */
function updateMenuDrawerPosition() {
    // Altura del anuncio superior (si existe)
    var scrolling_height = $('#top_header_optimize').outerHeight() || 0;
    // Altura del header principal
    var header_height = $('header').outerHeight() || 0;
    
    // Altura del menú móvil en XS (solo si está visible)
    var $mobileNav = $('.mobile_nav_div.visible-xs');
    var mobile_nav_height = 0;
    if ($mobileNav.length && $mobileNav.is(':visible')) {
        var nav_bottom = $mobileNav.offset().top + $mobileNav.outerHeight();
        if ($(window).scrollTop() < nav_bottom) {
            mobile_nav_height = $mobileNav.outerHeight();
        }
    }
    
    // Altura total a desplazar
    var overall_header = header_height + scrolling_height + mobile_nav_height;
    
    // Ajustamos posición y altura del drawer
    $('.menu-drawer').css({
        'top': overall_header + 'px',
        'height': 'calc(100% - ' + overall_header + 'px)'
    });
    
    // Y la capa fija
    $('.fixed-overlay').css('top', overall_header + 'px');
}

// Sistema de reintentos para buscar el elemento top_header_optimize
function initializeWithRetry() {
    var retryCount = 0;
    var maxRetries = 2; // Intentará 3 veces en total (0, 1, 2)
    var timeouts = [1000, 2000]; // 1 segundo, luego 2 segundos
    
    function attemptInitialization() {
        var $topHeader = $('#top_header_optimize');
        
        // Si encuentra el elemento o ya agotó los reintentos, procede
        if ($topHeader.length > 0 || retryCount >= maxRetries) {
            if (retryCount > 0 && $topHeader.length > 0) {
                console.log('top_header_optimize encontrado después de ' + retryCount + ' reintentos');
            } else if (retryCount >= maxRetries && $topHeader.length === 0) {
                console.log('top_header_optimize no encontrado después de ' + maxRetries + ' reintentos, continuando sin él');
            }
            
            // Ejecuta la función principal
            updateMenuDrawerPosition();
            
            // Configura los event listeners
            $(window).off('scroll.headerDrawer resize.headerDrawer').on('scroll.headerDrawer resize.headerDrawer', function() {
                updateMenuDrawerPosition();
            });
            
            return;
        }
        
        // Si no encuentra el elemento, programa el siguiente intento
        console.log('top_header_optimize no encontrado, reintentando en ' + timeouts[retryCount] + 'ms...');
        setTimeout(function() {
            retryCount++;
            attemptInitialization();
        }, timeouts[retryCount]);
    }
    
    // Inicia el primer intento
    attemptInitialization();
}

$(document).ready(function() {
    initializeWithRetry();
});
document.addEventListener('shopify:section:load', function() {
    initializeWithRetry();
});

function resetHeaderEditorPreviewState(root) {
    if (!window.Shopify || !Shopify.designMode) return;

    document.body.classList.remove('has-dropdown-menu');

    (root || document).querySelectorAll('details[is="details-dropdown"], details[is="details-mega"]').forEach(function(details) {
        details.open = false;
        details.removeAttribute('open');
        details.querySelector('summary')?.removeAttribute('open');
        details.querySelector('.dropdown, .mega-menu')?.removeAttribute('open');
    });

    (root || document).querySelectorAll('.drawer[active], .drawer[open], menu-drawer[active], menu-drawer[open]').forEach(function(drawer) {
        drawer.removeAttribute('active');
        drawer.removeAttribute('open');
        drawer.setAttribute('hidden', '');
    });

    (root || document).querySelectorAll('.fixed-overlay').forEach(function(overlay) {
        overlay.style.opacity = '';
        overlay.style.visibility = '';
        overlay.style.pointerEvents = '';
        overlay.style.backgroundColor = '';
    });
}

document.addEventListener('shopify:section:load', function(event) {
    resetHeaderEditorPreviewState(event.target);
    requestAnimationFrame(function() {
        updateMenuDrawerPosition();
    });
});
