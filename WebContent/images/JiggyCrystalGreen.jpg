/* Estilo del mensaje: alineado a la izquierda, tamaño de fuente ajustado */
.cc-message {
    text-align: left !important; /* Alineación a la izquierda */
    line-height: 1.5em !important; /* Espaciado para mejorar legibilidad */
    margin: 0 !important; /* Sin márgenes adicionales */
    font-size: 14px; /* Tamaño de fuente */
    color: rgb(0, 0, 0); /* Texto en color negro */
    margin-right: 30px !important; /* Espacio a la derecha para separar el texto de los bordes */
}

/* Centra horizontalmente y fija en la parte inferior */
.nUq3103wCWsjK0SoPHOw {
    bottom: 0 !important; /* Posición fija en la parte inferior */
    left: 50%; /* Centrado horizontalmente */
    transform: translateX(-50%) !important; /* Corrección para un centrado preciso */
}</style></template></csm-cookie-consent><shop-cart-sync data-instance-id="ee411091-5b83-41cc-9325-55d3b90cdc16"><template shadowrootmode="open"><iframe aria-hidden="true" data-testid="shop-cart-sync-iframe" src="https://shop.app/pay/hop?analytics_trace_id=ee411091-5b83-41cc-9325-55d3b90cdc16&amp;target_origin=https%3A%2F%2Fit.dfranklincreation.com&amp;client_handle=dfranklin-eu.myshopify.com" tabindex="-1" title="Shop Pay cart sync" style="display: none;"></iframe></template></shop-cart-sync><div id="batBeacon582876865722" style="width: 0px; height: 0px; display: none; visibility: hidden;" bis_skin_checked="1"><img id="batBeacon217386838516" width="0" height="0" alt="" src="./Jiggy Crystal Green_files/0" style="width: 0px; height: 0px; display: none; visibility: hidden;"></div><div data-lion-react-container="" bis_skin_checked="1"></div><div bis_skin_checked="1"><div id="loyaltylion" bis_skin_checked="1"><div id="lion-loyalty-panel-custom-css" bis_skin_checked="1"><div bis_skin_checked="1"></div><div bis_skin_checked="1"></div><div bis_skin_checked="1"></div><div bis_skin_checked="1"></div><div role="region" aria-label="Notifiche" aria-live="polite" class="lion-notification-container lion-notification-container--top-right" bis_skin_checked="1"></div></div></div></div>
