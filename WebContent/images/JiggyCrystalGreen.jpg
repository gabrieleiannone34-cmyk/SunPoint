  /* -------------------------------------------------------------
PRODUCT ICONS 
------------------------------------------------------------- */


.FlexItem {
  position: relative;
}

.product-badges--container {
  position: absolute;
  display: flex;
  z-index: 2;
  pointer-events: none;
}

li.product__media-item.grid__item.slider__slide {
  position: relative;
}

.product-badges--container.product_page {
  position: absolute;
  top: 12px;
  right: 12px;
  bottom: auto;
  left: auto;
  display: flex;
  justify-content: flex-end;
  transform: none;
  z-index: 5;
}

/* BADGE LISTADO / GRID */

.product-badges--container.product-badges--top {
  top: 13px;
  bottom: auto;
}

.product-badges--container.product-badges--bottom {
  bottom: 13px;
  top: auto;
}

/* POSICIÓN HORIZONTAL */

.product-badges--container.product-badges-x--left {
  left: 6px;
  right: auto;
  transform: none;
  justify-content: flex-start;
}

.product-badges--container.product-badges-x--center {
  left: 50%;
  right: auto;
  transform: translateX(-50%);
  justify-content: center;
}

.product-badges--container.product-badges-x--right {
  left: auto;
  right: 6px;
  transform: none;
  justify-content: flex-end;
}

.product-badges--container.product_page {
  top: 12px;
  right: 12px;
  bottom: auto;
  left: auto;
  justify-content: flex-end;
  transform: none;
}

/* BADGE SIZE */

span.product-badge {
  display: flex;
  width: 120px;
}

span.product-badge img {
  display: block;
  width: 100%;
  height: auto;
  max-width: none;
}


/* -------------------------------------------------------------
FICHA DE PRODUCTO
icono arriba derecha
------------------------------------------------------------- */

@media only screen and (min-width: 701px) {
  .product__media-item .product-badges--container.product_page {
    display: flex;
  }

/* Ocultar badge en todos los FlexItem del producto */
.FlexItem .product-badges--container.product_page,
.FlexItem .product-badges--container.product-badges--top {
  display: none;
}

/* Mostrar badge solo en el primer FlexItem */
.FlexItem:first-of-type .product-badges--container.product_page,
.FlexItem:first-of-type .product-badges--container.product-badges--top {
  display: flex;
  top: 12px;
  right: 12px;
  left: auto;
  bottom: auto;
  z-index: 0;
}
}


/* -------------------------------------------------------------
MOBILE
------------------------------------------------------------- */

@media only screen and (max-width: 700px) {

  .product__media-item 
  .product-badges--container.product-badges--bottom {
    bottom: 11px;
  }

  .product__media-item 
  .product-badges--container.product-badges--top {
    top: 11px;
  }

  .product-badges--container.product-badges-x--left {
    left: 9px;
  }

  .product-badges--container.product-badges-x--right {
    right: 9px;
  }

  span.product-badge {
    width: 100px;
  }

  .product__media-item .product-badges--container.product_page {
    display: flex;
    top: 12px;
    right: 12px;
    left: auto;
    bottom: auto;
    z-index: 5;
  }

}
</style>












