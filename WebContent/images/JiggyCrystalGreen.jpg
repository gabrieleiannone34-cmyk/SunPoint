            <script>
              (function() {
                var root = document.getElementById("PromoPulseProductPromoTab-promopulse_promo_tab_zBpaBc-template--31361278607685__main");
                if (!root) return;

                var slot = root.querySelector('[data-promopulse-slot="product-promo"]');

                function syncPromoPulseTab() {
                  if (!slot) return;

                  var promo = slot.querySelector(".promopulse-product-promo");
                  var hasPromo = !!promo && promo.textContent.trim() !== "";

                  root.hidden = !hasPromo;
                  root.style.display = hasPromo ? "" : "none";

                  if (!hasPromo) return;

                  var computed = window.getComputedStyle(promo);
                  var background = promo.style.backgroundColor || computed.backgroundColor;
                  var color = promo.style.color || computed.color;
                  var fontFamily = promo.style.fontFamily || computed.fontFamily;
                  var fontSize = promo.style.fontSize || computed.fontSize;

                  if (background) root.style.setProperty("--promopulse-tab-bg", background);
                  if (color) root.style.setProperty("--promopulse-tab-color", color);
                  if (fontFamily) root.style.setProperty("--promopulse-tab-font-family", fontFamily);
                  if (fontSize) root.style.setProperty("--promopulse-tab-font-size", fontSize);
                }

                var observer = new MutationObserver(syncPromoPulseTab);
                observer.observe(slot, {
                  childList: true,
                  subtree: true,
                  characterData: true,
                  attributes: true
                });

                syncPromoPulseTab();
                window.setTimeout(syncPromoPulseTab, 100);
                window.setTimeout(syncPromoPulseTab, 500);
                window.setTimeout(syncPromoPulseTab, 1500);
              })();
            </script>
