<!-- BEGIN app snippet: ibg-editor-mode -->
<script>
  /* RENDIMIENTO: el editor visual (ibg-editor-mode.js, ~51KB) solo lo usa el
     merchant, nunca el comprador. Antes se descargaba y parseaba en TODAS las
     paginas del storefront (peso desperdiciado). Ahora un loader minusculo lo
     inyecta SOLO si el visitante viene en modo editor — mismo guard que usa el
     propio script: ?ibg_editor=true, sessionStorage["ibg_editor_active"], o el
     <meta name="ibg-editor-active">. Los compradores no lo descargan. */
  (function () {
    try {
      var active =
        new URLSearchParams(window.location.search).get("ibg_editor") === "true" ||
        (function () { try { return sessionStorage.getItem("ibg_editor_active") === "1"; } catch (_) { return false; } })() ||
        !!document.querySelector('meta[name="ibg-editor-active"]');
      if (!active) return;
      var s = document.createElement("script");
      s.src = "https://cdn.shopify.com/extensions/01a01a88-8143-766e-ae98-5d88a85c1a7e/ibg_cro_lab-113/assets/ibg-editor-mode.js";
      s.defer = true;
      (document.head || document.documentElement).appendChild(s);
    } catch (_) {}
  })();
</script>
<!-- END app snippet -->




  
