          <script>
            (() => {
              const root = document.getElementById('ShippingReturnsTabs-content_popup_3yUJF4-template--31361278607685__main');
              if (!root || root.dataset.tabsInitialized === 'true') return;

              root.dataset.tabsInitialized = 'true';
              root.addEventListener('click', (event) => {
                const button = event.target.closest('[data-shipping-return-tab]');
                if (!button || !root.contains(button)) return;

                const activeTab = button.dataset.shippingReturnTab;

                root.querySelectorAll('[data-shipping-return-tab]').forEach((tab) => {
                  const isActive = tab === button;
                  tab.classList.toggle('active', isActive);
                  tab.setAttribute('aria-selected', String(isActive));
                });

                root.querySelectorAll('[data-shipping-return-panel]').forEach((panel) => {
                  const isActive = panel.dataset.shippingReturnPanel === activeTab;
                  panel.classList.toggle('active', isActive);
                  panel.hidden = !isActive;
                });
              });
            })();
          </script></div></div>

