  <!-- Estilos específicos para el slider de recomendaciones -->
  <style>
    /* Estilos para el slider de recomendaciones */
    .recommendations-slider {
      overflow: visible !important;
      width: 100%;
      position: relative;
      z-index: 1;
      touch-action: pan-y pinch-zoom;
    }
    /* Forzar que los slide tengan un ancho fijo */
    .recommendations-slider .swiper-slide {
      cursor: grab;
    }
    /* Ocultar los controles de navegación (flechas) */
    .swiper-controls {
      display: none !important;
    }
    /* Asegurar que el viewport de Swiper muestre los elementos parciales */
    .swiper-container {
      overflow: visible !important;
      width: 100% !important;
      z-index: 1;
      transition: height 0.2s ease;
    }
  </style>

  <script>
  async function regaloPadre () {
    try {
      var promocode = (leerCookie("promocode") || '').toUpperCase();
      var recomPromocode = ("DAD" || '').toUpperCase();
      var recomTag = "Collection_Sunglasses";

      var cartDrawer1 = document.querySelector('cart-drawer-recommendations');
      var cartDrawer2 = document.querySelector('cart-drawer-recommendations2');

      const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
      const cart = await cartResponse.json();

      let hasProductWithTag = false;

      const uniqueHandles = [...new Set(
        (cart.items || [])
          .map(item => item.handle)
          .filter(Boolean)
      )];

      for (const handle of uniqueHandles) {
        const productResponse = await fetch(window.Shopify.routes.root + 'products/' + handle + '.js');
        const product = await productResponse.json();

        if (product.tags && product.tags.includes(recomTag)) {
          hasProductWithTag = true;
          break;
        }
      }    

      if (promocode === recomPromocode && hasProductWithTag) {
        if (cartDrawer1) cartDrawer1.style.display = 'none';
        if (cartDrawer2) cartDrawer2.style.display = 'block';
      } else {
        if (cartDrawer1) cartDrawer1.style.display = 'block';
        if (cartDrawer2) cartDrawer2.style.display = 'none';
      }

    } catch (error) {
      console.error('Error en regaloPadre():', error);
    }    
  }

  document.addEventListener('DOMContentLoaded', function () {
    let cartSwiper;
  
    function initializeSlider() {
        const sliderElement = document.getElementById('recommendationsSlider');
        if (!sliderElement) {
            console.log("Slider not found.");
            return;
        }

        const slides = sliderElement.querySelectorAll('.swiper-slide');
        if (slides.length === 0) {
            console.log("No slides found in recommendations slider.");
            return;
        }

        // Hide the slider ONLY if it's visible to prevent flickering
        if (sliderElement.style.opacity !== "0") {
            sliderElement.style.opacity = "0";
            sliderElement.style.transition = "opacity 0.3s ease-in-out";
        }

        // Destroy previous Swiper instance if it exists
        if (cartSwiper && cartSwiper.destroy) {
            cartSwiper.destroy(true, true);
        }

        // Reinitialize Swiper
        cartSwiper = new Swiper('#recommendationsSlider', {
            slidesPerView: 2.5,
            loop: slides.length > 3,
            watchOverflow: true,
            observer: true,
            observeParents: true,
            mousewheel: {
                enabled: true,
                sensitivity: 1,
                forceToAxis: true,
                onlyInViewport: true,
                thresholdDelta: 50,
                thresholdTime: 300
            },
            breakpoints: {
                768: { slidesPerView: 3 },
                1024: { slidesPerView: 2.5 }
            }
        });

        // Show the slider after Swiper is fully set up
        setTimeout(() => {
            sliderElement.style.opacity = "1";
        }, 300);
    }

    function reinitializeOnCartUpdate() {
        console.log("Cart updated. Reinitializing Swiper...");
        initializeSlider();
        regaloPadre();
        console.log("LISTENER");        
    }

    // Listen to cart updates and quantity changes
    document.addEventListener('cart:updated', reinitializeOnCartUpdate);
    document.addEventListener('change', function (event) {
        if (event.target.matches('.quantity__input')) {
            reinitializeOnCartUpdate();
        }        
    });

    // Listen to product removal
    document.addEventListener('click', function (event) {
        if (event.target.closest('.cart-item__remove')) {
            reinitializeOnCartUpdate();
        }
    });
    
    // Initialize the slider when the cart drawer opens
    initializeSlider();
    regaloPadre();
});
  </script>
