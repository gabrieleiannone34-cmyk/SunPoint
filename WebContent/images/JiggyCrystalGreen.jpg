document.addEventListener("DOMContentLoaded", function() {
    setTimeout(function() {
    var soldOutElem = document.querySelector('.klavio-sold-out');
    if (soldOutElem && soldOutElem.tagName.toLowerCase() === 'a') {
        var btn = document.createElement('button');
        btn.innerHTML = soldOutElem.innerHTML;
        btn.className = soldOutElem.className;
        btn.style.cssText = soldOutElem.style.cssText;
        btn.addEventListener('click', function(e) {
        e.preventDefault();
        soldOutElem.click();
        });
        soldOutElem.parentNode.replaceChild(btn, soldOutElem);
    }
    }, 200);
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
    function toggleSoldOutButton() {
    var addToCartButton = document.querySelector('form[action^="/cart"] [type="submit"]');
    var soldOutButton = document.querySelector('.klavio-sold-out');
    if (!addToCartButton || !soldOutButton) {
        return;
    }
    if (addToCartButton.disabled) {
        soldOutButton.style.display = 'block';
    } else {
        soldOutButton.style.display = 'none';
    }
    }
    
    var productForm = document.querySelector('form[action^="/cart"]');
    if (productForm) {
    productForm.addEventListener('change', function() {
        setTimeout(toggleSoldOutButton, 100);
    });
    }
    
    toggleSoldOutButton();
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function() {
// Creamos un observador para detectar cuando se añaden nodos al body
var observer = new MutationObserver(function(mutationsList, observer) {
    mutationsList.forEach(function(mutation) {
    mutation.addedNodes.forEach(function(addedNode) {
        if (
        addedNode.tagName &&
        addedNode.tagName.toLowerCase() === "iframe" &&
        addedNode.id === "klaviyo-bis-iframe"
        ) {
        // Cuando el iframe se carga, inyectamos los estilos deseados
        addedNode.onload = function() {
            var iframeDoc = addedNode.contentDocument || addedNode.contentWindow.document;
            if (iframeDoc) {
            var styleElement = document.createElement("style");
            styleElement.type = "text/css";
            styleElement.innerHTML = ".modal-title { font-family: unset !important; } .btn-success { background-color: black !important; border-color: black !important; }";
            iframeDoc.head.appendChild(styleElement);
            }
        };
        }
    });
    });
});

// Observamos el body para detectar cambios en el DOM (incluyendo elementos hijos en profundidad)
observer.observe(document.body, { childList: true, subtree: true });
});
</script>


    
