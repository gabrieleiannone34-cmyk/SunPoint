<script>
  /* This is for set ATC button by default as SELECT SIZE */
  document.addEventListener("DOMContentLoaded", function () {
    var variantOptions = document.querySelectorAll('.product_variant_option_inner input[type="radio"]');
    var addToCartButton = document.querySelector('.product-form__submit span');
    var addToCartButtonContainer = document.querySelector('.product-form__submit');
    var addToCartButtonElement = document.querySelector('.product-form__submit'); // The actual button element

    // Check if the "Add to Cart" button is disabled
    if (addToCartButtonElement && !addToCartButtonElement.disabled && variantOptions.length > 1) {
        addToCartButton.textContent = "Scegli la taglia";

        variantOptions.forEach(function (option) {
            option.checked = false;

            option.addEventListener("change", function () {
                addToCartButton.textContent = "Aggiungi al carrello";
            });
        });

        addToCartButtonContainer.addEventListener("click", function (event) {
            var selectedVariant = document.querySelector('.product_variant_option_inner input[type="radio"]:checked');
            if (!selectedVariant) {
                event.preventDefault();
                addToCartButton.textContent = "Per favore, scegli una taglia";

                addToCartButtonContainer.classList.add("shake");

                setTimeout(function () {
                    addToCartButtonContainer.classList.remove("shake");
                }, 500);
            }
        });
    }
  });
</script>

