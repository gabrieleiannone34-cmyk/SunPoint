<style>
  .plp_nav_bar a[data-plp-bubble-color-target='text'],
  .plp_nav_bar a[data-plp-bubble-color-target='text'] span {
    color: var(--plp-bubble-custom-color) !important;
  }

  .plp_nav_bar a[data-plp-bubble-color-target='background'] {
    background-color: var(--plp-bubble-custom-color) !important;
  }

  .plp_nav_bar a[data-plp-bubble-color-target='both'] {
    background-color: var(--plp-bubble-custom-color) !important;
    color: var(--plp-bubble-custom-text-color) !important;
  }

  .plp_nav_bar a[data-plp-bubble-color-target='both'] span {
    color: var(--plp-bubble-custom-text-color) !important;
  }

  .plp_nav_bar a[data-plp-bubble-bold='true'] {
    font-weight: 700 !important;
  }
</style>

<script>
  (function () {
    const bubbleColor = window.DFranklinPlpBubbleColor || {};

    bubbleColor.configuredItems = [];
    bubbleColor.target = "text";
    bubbleColor.color = "#800000";
    bubbleColor.textColorWhenBoth = "#ffffff";
    bubbleColor.bold = false;

    bubbleColor.toHandle = function (value) {
      return String(value || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    };

    bubbleColor.getConfiguredHandle = function (value) {
      const configuredValue = String(value || '').trim();

      if (!configuredValue) return '';

      try {
        const url = new URL(configuredValue, window.location.origin);
        const segments = decodeURIComponent(url.pathname).split('/').filter(Boolean);
        return bubbleColor.toHandle(segments.pop());
      } catch (error) {
        return bubbleColor.toHandle(configuredValue);
      }
    };

    bubbleColor.handles = bubbleColor.configuredItems
      .map((item) => bubbleColor.getConfiguredHandle(item))
      .filter(Boolean);

    bubbleColor.getHandle = function (link) {
      try {
        const url = new URL(link.getAttribute('href') || '', window.location.origin);
        const segments = decodeURIComponent(url.pathname).split('/').filter(Boolean);
        return bubbleColor.toHandle(segments.pop());
      } catch (error) {
        return '';
      }
    };

    bubbleColor.apply = function (root) {
      const scope = root && root.querySelectorAll ? root : document;

      scope.querySelectorAll('.plp_nav_bar a').forEach((link) => {
        const matches = bubbleColor.handles.includes(bubbleColor.getHandle(link));

        if (!matches || !bubbleColor.color) {
          link.removeAttribute('data-plp-bubble-color-target');
          link.removeAttribute('data-plp-bubble-bold');
          link.style.removeProperty('--plp-bubble-custom-color');
          link.style.removeProperty('--plp-bubble-custom-text-color');
          return;
        }

        link.dataset.plpBubbleColorTarget = bubbleColor.target;
        link.style.setProperty('--plp-bubble-custom-color', bubbleColor.color);

        if (bubbleColor.target === 'both') {
          link.style.setProperty('--plp-bubble-custom-text-color', bubbleColor.textColorWhenBoth);
        } else {
          link.style.removeProperty('--plp-bubble-custom-text-color');
        }

        if (bubbleColor.bold) {
          link.dataset.plpBubbleBold = 'true';
        } else {
          link.removeAttribute('data-plp-bubble-bold');
        }
      });
    };

    if (!bubbleColor.eventsBound) {
      document.addEventListener('DOMContentLoaded', function () {
        bubbleColor.apply(document);
      });
      document.addEventListener('shopify:section:load', function () {
        bubbleColor.apply(document);
      });
      bubbleColor.eventsBound = true;
    }

    window.DFranklinPlpBubbleColor = bubbleColor;

    if (document.readyState !== 'loading') {
      bubbleColor.apply(document);
    }
  })();
</script>   

