<script>
document.addEventListener('DOMContentLoaded', function () {
  const productGender = document.getElementById('product-gender')?.textContent.trim();

  let sizeMappings = {};
  if (productGender === 'women' || productGender === 'mujer') {
    sizeMappings = {
      '36': { 'EU': '36', 'US': '6', 'UK': '3' },
      '37': { 'EU': '37', 'US': '6.5', 'UK': '4' },
      '38': { 'EU': '38', 'US': '7.5', 'UK': '5' },
      '39': { 'EU': '39', 'US': '8', 'UK': '6' },
      '40': { 'EU': '40', 'US': '8.5', 'UK': '6.5' },
      '41': { 'EU': '41', 'US': '10', 'UK': '7.5' },
      '42': { 'EU': '42', 'US': '10.5', 'UK': '8' }
    };
  } else if (productGender === 'men' || productGender === 'hombre') {
    sizeMappings = {
      '40': { 'EU': '40', 'US': '7', 'UK': '6.5' },
      '41': { 'EU': '41', 'US': '8', 'UK': '7.5' },
      '42': { 'EU': '42', 'US': '8.5', 'UK': '8' },
      '43': { 'EU': '43', 'US': '9', 'UK': '9' },
      '44': { 'EU': '44', 'US': '10', 'UK': '9.5' },
      '45': { 'EU': '45', 'US': '11', 'UK': '10' },
      '46': { 'EU': '46', 'US': '12', 'UK': '11' }
    };
  } else {
    console.warn('Product gender not specified or unrecognized.');
    return;
  }

  const sizeTabContainers = document.querySelectorAll('.cstm_sizes');
  const variantSelect = document.querySelector('input[name="id"]');
  const swatchLabels = document.querySelectorAll('.changeable');
  const variants = JSON.parse(document.querySelector('script[type="application/json"]').textContent);

  const availableSizes = Array.from(swatchLabels).map(label => label.textContent.trim());

  const sizeConversion = {
    'EU': availableSizes,
    'US': availableSizes.map(size => sizeMappings[size] ? sizeMappings[size]['US'] : null),
    'UK': availableSizes.map(size => sizeMappings[size] ? sizeMappings[size]['UK'] : null)
  };

  let currentUnit = 'EU';

  function updateSizeLabels(unit) {
    const sizeList = sizeConversion[unit] || [];
    swatchLabels.forEach((label, index) => {
      if (sizeList[index]) {
        label.textContent = sizeList[index];
      } else {
        label.textContent = '';
      }
    });
  }

  // Function to update the variant ID when selecting a size
  function updateVariantId(selectedSize) {
    const index = sizeConversion[currentUnit].indexOf(selectedSize);
    if (index === -1) {
      console.warn(`Size ${selectedSize} not found in ${currentUnit}.`);
      return;
    }
    const sizeEU = sizeConversion['EU'][index]; // Get corresponding EU size
    const matchingVariant = variants.find(variant => variant.options[0] === sizeEU && variant.available);
    if (matchingVariant) {
      variantSelect.value = matchingVariant.id;
    } else {
      console.warn(`No available variant for EU size ${sizeEU}.`);
    }
  }

  // Initial update to display correct sizes
  updateSizeLabels(currentUnit);

  // Event listeners for switching size units
  sizeTabContainers.forEach(ul => {
    const sizeTabs = ul.querySelectorAll('li');

    sizeTabs.forEach(tab => {
      tab.addEventListener('click', function () {
        // Remove active class from all tabs in the same container
        ul.querySelector('.active_size')?.classList.remove('active_size');
        this.classList.add('active_size');

        // Get selected unit (EU, US, UK)
        currentUnit = this.textContent.trim();

        // Update size labels
        updateSizeLabels(currentUnit);
      });
    });
  });

  // Event listeners for selecting a size from swatches
  swatchLabels.forEach(label => {
    label.addEventListener('click', function () {
      const selectedSize = this.textContent.trim();
      updateVariantId(selectedSize);
    });
  });
});
</script>

